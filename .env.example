# Aura sunucusu ortam değişkenleri. Kopyalayıp .env olarak doldur; Vercel'de Project Settings > Environment Variables'a ekle.
# Kodda hiçbir gizli değerin yedeği yoktur: zorunlu bir değişken eksikse ilgili özellik hata verir.

# Zorunlu
MONGODB_URI=mongodb+srv://KULLANICI:SIFRE@cluster.example.mongodb.net/?appName=Aura
# En az 32 karakter. Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# İsteğe bağlı
APP_URL=http://localhost:3000

# Günlük kombin bildirimi (web push). Anahtar üretmek için: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@ornek.com

# Vercel Cron'un /api/cron/daily çağrısını doğrulayan anahtar (en az 16 karakter)
CRON_SECRET=

# Model listelerini yeniden deploy etmeden değiştirmek için (virgülle ayrılmış, sıra öncelik sırasıdır)
# GEMINI_MODELS_STYLIST=gemini-3.6-flash,gemini-2.5-flash
# GEMINI_MODELS_VISION=gemini-3.5-flash-lite,gemini-3.1-flash-lite
